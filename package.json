{
  "name": "macross",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev:trainer": "turbo run dev --filter=@macross/trainer",
    "dev:client": "turbo run dev --filter=@macross/client",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:shared": "turbo run test --filter=@macross/shared",
    "test:trainer": "turbo run test --filter=@macross/trainer",
    "test:client": "turbo run test --filter=@macross/client",
    "db:generate": "supabase gen types typescript --local --schema public > packages/shared/types/database.ts",
    "db:generate:prod": "supabase gen types typescript --project-id zxztpzsavoqykbbokget --schema public > packages/shared/types/database.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "commit": "cz",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "prepare": "husky",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.73.0",
    "supabase": "^2.109.1",
    "turbo": "^2.10.4"
  },
  "lint-staged": {
    "*.{ts,vue,js}": [
      "oxlint --fix",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,yaml}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "packageManager": "pnpm@10.33.0"
}
