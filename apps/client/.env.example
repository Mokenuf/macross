# Default: base local de Supabase (pnpm db:start). Las keys las imprime `pnpm db:status`.
# Para apuntar a producción: copiar a .env.prod con las keys reales y usar `pnpm dev:client:prod`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=your-local-publishable-key
NUXT_CLIENT_APP_URL=http://localhost:3001
