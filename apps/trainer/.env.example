# Default: base local de Supabase (pnpm db:start). Las keys las imprime `pnpm db:status`.
# Para apuntar a producción: copiar a .env.prod con las keys reales y usar `pnpm dev:trainer:prod`.
# El .env.prod NO lleva SUPABASE_SECRET_KEY a propósito: así una sesión de dev contra producción
# corre con permisos de usuario normal y RLS es la cerca (los invites no funcionan en ese modo).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=your-local-publishable-key
SUPABASE_SECRET_KEY=your-local-secret-key
NUXT_TRAINER_APP_URL=http://localhost:3000
NUXT_CLIENT_APP_URL=http://localhost:3001
