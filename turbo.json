{
  "$schema": "https://v2-9-5.turborepo.dev/schema.json",
  "globalEnv": [
    "SUPABASE_URL",
    "SUPABASE_KEY",
    "SUPABASE_SECRET_KEY",
    "NUXT_TRAINER_APP_URL",
    "NUXT_CLIENT_APP_URL"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", ".nuxt/**", ".vercel/output/**"]
    },
    "test": {
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
